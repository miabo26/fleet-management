# ==============================================================
# Egypt Post Fleet & Logistics Management System — Environment Config
# ==============================================================

PORT=5001

# --- Google Cloud Firestore / Firebase Configuration ---
# 1. Provide your Firebase Project ID:
FIREBASE_PROJECT_ID=egypt-post-fleet

# 2. Or provide Google Service Account JSON (paste full JSON string or file path):
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# --- Optional MongoDB Atlas URI ---
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
